<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="challengeModSettings">
    <GuiElement profile="fs25_menuContainer">
        <!-- Header -->
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" id="categoryHeaderIcon"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="categoryHeaderText" text="ui_challengemod_settings"/>
        </GuiElement>

        <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="0px -57px"/>
        
        <!-- Info Text -->
        <Text profile="fs25_settingsSectionHeader" position="0px -100px" size="1400px 60px"
            text="ui_challengemod_settingsInfo"/>

        <!-- Multiplier List -->
        <GuiElement profile="fs25_statisticsHeaderBox" position="0px -200px">
            <Text profile="fs25_statisticsHeaderText" text="ui_challengemod_multiplierName"/>
            <Text profile="fs25_statisticsHeaderText" position="340px 0px" text="ui_challengemod_multiplierValue"/>
            <Text profile="fs25_statisticsHeaderText" position="680px 0px" text="ui_challengemod_multiplierPoints"/>
            <Text profile="fs25_statisticsHeaderText" position="1020px 0px" text="ui_challengemod_multiplierMode"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px -2dp"/>
        </GuiElement>
        
        <SmoothList profile="cpLeftList" id="settingsList" position="0px -280px" focusChangeTop="nil" focusChangeBottom="nil">
            <ListItem profile="fs25_pricesProductListItem">
                <Text name="title" profile="fs25_pricesProductListItemName"/>
                <Text name="column2" profile="fs25_pricesProductListItemName" position="340px 0px"/>
                <Text name="column3" profile="fs25_pricesProductListItemName" position="680px 0px"/>
                <Text name="column4" profile="fs25_pricesProductListItemName" position="1020px 0px"/>
            </ListItem>
        </SmoothList>
    </GuiElement>
</GUI>
